//
// Prisma schema for Micro-Skill LMS
//

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = env("DATABASE_PROVIDER") // allows swapping to postgres later; default overridden by URL
  url      = env("DATABASE_URL")
}

//
// Models
//

model User {
  id           String   @id @default(cuid())
  email        String   @unique
  passwordHash String
  name         String?
  avatarUrl    String?
  createdAt    DateTime @default(now())

  quizAttempts QuizAttempt[]
  progress     Progress[]
}

model Skill {
  id          String   @id @default(cuid())
  name        String
  description String?

  modules     Module[]
}

model Module {
  id          String   @id @default(cuid())
  skillId     String
  title       String
  description String?
  order       Int
  isPublished Boolean  @default(false)

  skill   Skill   @relation(fields: [skillId], references: [id], onDelete: Cascade)
  videos  Video[]
  progress Progress[]
  quizQuestions QuizQuestion[]

  @@index([skillId])
}

model Video {
  id              String   @id @default(cuid())
  moduleId        String
  title           String
  url             String
  durationSeconds Int
  order           Int
  transcriptUrl   String?
  captionsUrl     String?
  thumbnailUrl    String?
  createdAt       DateTime @default(now())

  module        Module       @relation(fields: [moduleId], references: [id], onDelete: Cascade)
  summary       Summary?
  quizQuestions QuizQuestion[]
  quizAttempts  QuizAttempt[]

  @@index([moduleId])
}

model Summary {
  id             String  @id @default(cuid())
  videoId        String  @unique
  content        String
  readingTimeSec Int

  video Video @relation(fields: [videoId], references: [id], onDelete: Cascade)
}

model QuizQuestion {
  id          String  @id @default(cuid())
  videoId     String?
  moduleId    String?
  text        String
  order       Int
  multiSelect Boolean @default(false)

  // Relations
  video   Video?  @relation(fields: [videoId], references: [id], onDelete: Cascade)
  module  Module? @relation(fields: [moduleId], references: [id], onDelete: Cascade)
  answers QuizAnswer[]

  @@index([videoId])
  @@index([moduleId])
}

model QuizAnswer {
  id         String       @id @default(cuid())
  questionId String
  text       String
  isCorrect  Boolean @default(false)

  question QuizQuestion @relation(fields: [questionId], references: [id], onDelete: Cascade)

  @@index([questionId])
}

model QuizAttempt {
  id         String   @id @default(cuid())
  userId     String
  videoId    String?
  moduleId   String?
  score      Int
  total      Int
  startedAt  DateTime @default(now())
  completedAt DateTime?
  answers    Json

  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  video  Video? @relation(fields: [videoId], references: [id], onDelete: SetNull)
  module Module? @relation(fields: [moduleId], references: [id], onDelete: SetNull)

  @@index([userId])
  @@index([videoId])
  @@index([moduleId])
}

model Progress {
  id             String   @id @default(cuid())
  userId         String
  moduleId       String
  completedVideos Int     @default(0)
  totalVideos     Int     @default(0)
  lastVideoId     String?
  updatedAt       DateTime @updatedAt

  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  module Module @relation(fields: [moduleId], references: [id], onDelete: Cascade)

  @@unique([userId, moduleId], name: "user_module_unique")
  @@index([userId])
  @@index([moduleId])
}
