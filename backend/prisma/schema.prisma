//
//
// Prisma schema for Micro-Skill LMS
//
// Strengthened with additional indexes and constraints for content ordering,
// uniqueness, and faster lookups.
//
// Note: Some validations (e.g., email lowercasing) should be enforced in app code;
// here we add a normal index to support case-insensitive searches in Postgres later.
//

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = env("DATABASE_PROVIDER") // allows swapping to postgres later; default overridden by URL
  url      = env("DATABASE_URL")      // for sqlite use: "file:./data/dev.db"
}

//
// Models
//

model User {
  id           String   @id @default(cuid())
  email        String   @unique
  passwordHash String
  name         String?
  avatarUrl    String?
  createdAt    DateTime @default(now())

  quizAttempts QuizAttempt[]
  progress     Progress[]

  // Support queries by email quickly (esp. when migrating to Postgres with citext)
  @@index([email])
}

model Skill {
  id          String   @id @default(cuid())
  name        String
  description String?

  modules     Module[]

  // Prevent duplicate skill names (optional but useful)
  @@unique([name])
}

model Module {
  id          String   @id @default(cuid())
  skillId     String
  title       String
  description String?
  order       Int       // display order within a skill
  isPublished Boolean   @default(false)

  skill         Skill        @relation(fields: [skillId], references: [id], onDelete: Cascade)
  videos        Video[]
  progress      Progress[]
  quizQuestions QuizQuestion[]

  // Ensure a stable ordering within a skill
  @@unique([skillId, order], name: "module_order_within_skill_unique")
  @@index([skillId])
  @@index([isPublished])
}

model Video {
  id              String   @id @default(cuid())
  moduleId        String
  title           String
  url             String
  durationSeconds Int      // expected 30-90s in our domain; validated by seed/app
  order           Int      // display order within a module
  transcriptUrl   String?
  captionsUrl     String?
  thumbnailUrl    String?
  createdAt       DateTime @default(now())

  module        Module       @relation(fields: [moduleId], references: [id], onDelete: Cascade)
  summary       Summary?
  quizQuestions QuizQuestion[]
  quizAttempts  QuizAttempt[]

  // Ensure only one video per order within a module
  @@unique([moduleId, order], name: "video_order_within_module_unique")
  @@index([moduleId])
  @@index([createdAt])
}

model Summary {
  id             String  @id @default(cuid())
  videoId        String  @unique
  content        String
  readingTimeSec Int

  video Video @relation(fields: [videoId], references: [id], onDelete: Cascade)
}

model QuizQuestion {
  id          String  @id @default(cuid())
  videoId     String?
  moduleId    String?
  text        String
  order       Int
  multiSelect Boolean @default(false)

  // Relations
  video   Video?  @relation(fields: [videoId], references: [id], onDelete: Cascade)
  module  Module? @relation(fields: [moduleId], references: [id], onDelete: Cascade)
  answers QuizAnswer[]

  // Ensure ordering uniqueness within a video or within a module when scoped that way
  @@unique([videoId, order], map: "question_order_within_video_unique")
  @@unique([moduleId, order], map: "question_order_within_module_unique")
  @@index([videoId])
  @@index([moduleId])
}

model QuizAnswer {
  id         String       @id @default(cuid())
  questionId String
  text       String
  isCorrect  Boolean @default(false)

  question QuizQuestion @relation(fields: [questionId], references: [id], onDelete: Cascade)

  // Avoid accidental duplicates for same question/answer text
  @@unique([questionId, text], name: "answer_unique_per_question")
  @@index([questionId])
}

model QuizAttempt {
  id          String   @id @default(cuid())
  userId      String
  videoId     String?
  moduleId    String?
  score       Int
  total       Int
  startedAt   DateTime @default(now())
  completedAt DateTime?
  answers     Json

  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  video  Video? @relation(fields: [videoId], references: [id], onDelete: SetNull)
  module Module? @relation(fields: [moduleId], references: [id], onDelete: SetNull)

  @@index([userId])
  @@index([videoId])
  @@index([moduleId])
  @@index([completedAt])
}

model Progress {
  id              String   @id @default(cuid())
  userId          String
  moduleId        String
  completedVideos Int      @default(0)
  totalVideos     Int      @default(0)
  lastVideoId     String?
  updatedAt       DateTime @updatedAt

  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  module Module @relation(fields: [moduleId], references: [id], onDelete: Cascade)

  @@unique([userId, moduleId], name: "user_module_unique")
  @@index([userId])
  @@index([moduleId])
}
