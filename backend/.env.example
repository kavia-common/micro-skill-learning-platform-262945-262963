# Backend environment example
# PUBLIC_INTERFACE
# Copy to .env and fill secrets before running the backend.

# Service
PORT=3001
HOST=0.0.0.0
NODE_ENV=development

# CORS: set to your frontend origin(s). Comma-separated list supported.
# For local React app on default port:
CORS_ORIGIN=http://localhost:3000

# JWT secret (REQUIRED). Use a strong random value in real environments.
JWT_SECRET=replace-with-a-strong-random-secret

# Database (defaults for SQLite development)
DATABASE_PROVIDER=sqlite
DATABASE_URL="file:./data/dev.db"
