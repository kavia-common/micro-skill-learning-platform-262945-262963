# Backend environment example for Micro Skill LMS

# HTTP server
PORT=3001
HOST=0.0.0.0
NODE_ENV=development

# CORS - allow the React frontend
# IMPORTANT: keep this aligned with the frontend dev server URL
CORS_ORIGIN=http://localhost:3000

# JWT secret for signing auth tokens
# REQUIRED in runtime. Replace with a strong random string in real environments.
JWT_SECRET=replace_with_strong_random_secret

# Database provider and URL
# Default provider is set via env to allow switching to Postgres in the future.
# For local development using SQLite (file db), use:
DATABASE_PROVIDER=sqlite
DATABASE_URL="file:./data/dev.db"

# Prisma logging level is controlled by NODE_ENV in code.
