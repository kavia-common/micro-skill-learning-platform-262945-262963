# Backend environment example for Micro Skill LMS

# Server
PORT=3001
HOST=0.0.0.0

# CORS
# Comma-separated list of allowed origins. Include your frontend URL(s).
CORS_ORIGIN=http://localhost:3000

# Auth
# REQUIRED: Set a strong random value for JWT signing. Example: openssl rand -base64 32
JWT_SECRET=change-me-please

# Database (SQLite default)
DATABASE_PROVIDER=sqlite
# SQLite file path relative to backend directory
DATABASE_URL="file:./data/dev.db"

# Node environment
NODE_ENV=development
