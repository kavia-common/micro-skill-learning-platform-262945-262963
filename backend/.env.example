# Backend environment example for Micro Skill LMS

# Server
PORT=3001
HOST=0.0.0.0
NODE_ENV=development

# CORS - allow your frontend origins (comma-separated list)
# For local dev React:
CORS_ORIGIN=http://localhost:3000

# JWT secret used to sign and verify access tokens
# IMPORTANT: set to a strong random value in real environments
JWT_SECRET=change-me-to-a-strong-random-value

# Database (SQLite default)
DATABASE_PROVIDER=sqlite
DATABASE_URL="file:./data/dev.db"
