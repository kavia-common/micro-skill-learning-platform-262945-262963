# Backend environment example
PORT=3001
# Comma-separated exact origins (include React dev server)
CORS_ORIGIN=http://localhost:3000

# Legacy local JWT secret (kept during migration window)
JWT_SECRET=change-me-please

# Database (SQLite by default)
DATABASE_PROVIDER=sqlite
DATABASE_URL="file:./data/dev.db"

# Supabase settings for JWT verification (no secret needed here)
# Use your project URL like: https://your-project-id.supabase.co
SUPABASE_URL=

