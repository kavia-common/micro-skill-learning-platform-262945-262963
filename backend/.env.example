# Backend environment variables for Micro Skill LMS

# Server
PORT=3001
HOST=0.0.0.0
NODE_ENV=development

# CORS - exact frontend origins, comma separated for multiple
# Example: http://localhost:3000,http://127.0.0.1:3000
CORS_ORIGIN=http://localhost:3000

# JWT secret for legacy tokens (kept during Supabase migration)
# Generate a strong random value before running locally.
JWT_SECRET=change_me_please

# Database (SQLite default)
DATABASE_PROVIDER=sqlite
DATABASE_URL="file:./data/dev.db"

# Supabase - REQUIRED for Supabase JWT verification middleware
# Set to your Supabase project URL, e.g. https://YOUR_PROJECT_ID.supabase.co
SUPABASE_URL=

# Optional: trust proxy for deployments behind proxies (already enabled in app)
# TRUST_PROXY=true
