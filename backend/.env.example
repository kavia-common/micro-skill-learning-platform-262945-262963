# Backend environment example

PORT=3001
HOST=0.0.0.0

# CORS origins (comma-separated)
CORS_ORIGIN=http://localhost:3000

# Legacy JWT secret (migration period)
JWT_SECRET=changeme_please_make_random

# Prisma database configuration
# For SQLite (default for local dev)
DATABASE_PROVIDER=sqlite
DATABASE_URL="file:./data/dev.db"

# For Postgres (optional)
# DATABASE_PROVIDER=postgresql
# DATABASE_URL="postgresql://user:password@localhost:5432/micro_skill_lms?schema=public"

# Supabase (for JWT verification)
SUPABASE_URL=https://your-project-id.supabase.co
